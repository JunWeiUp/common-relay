[Unit]
Description=Common Relay encrypted device relay (protocol v2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=common-relay
StateDirectoryMode=0700
# Server access password and v2 Root Admin secret hashes (root:root 0600); see docs/DEPLOYMENT.md.
LoadCredential=access:/etc/common-relay/access-password.sha256
LoadCredential=v2admin:/etc/common-relay/v2-admin.sha256
ExecStart=/usr/local/bin/common-relay serve --data /var/lib/common-relay --listen 127.0.0.1:47805 --access-password-file ${CREDENTIALS_DIRECTORY}/access --v2-admin-hash-file ${CREDENTIALS_DIRECTORY}/v2admin
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=128
LimitNOFILE=2048
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
